{
  "name": "@rivm-loculus-tools/mono-repo",
  "version": "0.0.1",
  "license": "EUPL-1.2",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "pnpm --filter @rivm-loculus-tools/phylogeny-viewer start",
    "start-phylogeny-viewer": "pnpm --filter @rivm-loculus-tools/phylogeny-viewer start",
    "update-exports": "lerna run update-exports",
    "clean": "lerna clean && rm -fr node_modules",
    "validate": "lerna run validate --concurrency 1 --stream",
    "lint": "lerna run lint",
    "lint-fix": "lerna run lint-fix",
    "check-types": "lerna run check-types",
    "test": "lerna run test-run",
    "add-missing-translations": "lerna run add-missing-translations",
    "build": "lerna run build"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "lerna": "10.0.1",
    "typescript": "6.0.3"
  }
}