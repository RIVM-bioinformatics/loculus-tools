{
  "name": "@rivm-loculus-tools/frontend-common",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "validate": "pnpm run lint && pnpm run check-types",
    "lint": "eslint ./src --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint ./src --report-unused-disable-directives --max-warnings 0 --fix",
    "update-exports": "node scripts/update-exports.js",
    "check-types": "tsc --noEmit",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@emotion/cache": "*",
    "@emotion/react": "*",
    "@emotion/styled": "*",
    "@gen-epix/ui-core-components": "workspace:^",
    "@gen-epix/ui-core-form": "workspace:^",
    "@gen-epix/ui-core": "workspace:^",
    "@mui/icons-material": "*",
    "@mui/material": "*",
    "@mui/styled-engine": "*",
    "@mui/system": "*",
    "@mui/utils": "*",
    "i18next": "*",
    "react-dom": "*",
    "react-hook-form": "*",
    "react-i18next": "*",
    "react": "*"
  },
  "dependencies": {
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@gen-epix/eslint-config": "0.7.0",
    "@gen-epix/ui-core-components": "4.3.1",
    "@gen-epix/ui-core-form": "4.3.1",
    "@gen-epix/ui-core": "3.3.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/styled-engine": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/utils": "9.4.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.2",
    "@types/react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "i18next": "26.4.2",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.15",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vite-plugin-dts": "5.1.1",
    "vite-plugin-static-copy": "4.1.1",
    "vite": "8.3.0"
  },
  "exports": {
    "./components/I18nWrapper": {
      "types": "./src/components/I18nWrapper/index.ts",
      "import": "./src/components/I18nWrapper/index.ts"
    },
    "./components/page": {
      "types": "./src/components/page/index.ts",
      "import": "./src/components/page/index.ts"
    },
    "./constants/page": {
      "types": "./src/constants/page.ts",
      "import": "./src/constants/page.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./components/I18nWrapper": {
        "types": "./dist/components/I18nWrapper/index.d.ts",
        "import": "./dist/components/I18nWrapper/index.js"
      },
      "./components/page": {
        "types": "./dist/components/page/index.d.ts",
        "import": "./dist/components/page/index.js"
      },
      "./constants/page": {
        "types": "./dist/constants/page.d.ts",
        "import": "./dist/constants/page.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      }
    }
  }
}
