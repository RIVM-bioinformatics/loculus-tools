{
  "name": "@rivm-loculus-tools/mono-repo",
  "version": "0.0.1",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/RIVM-bioinformatics/loculus-tools"
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "pnpm run build-wasm",
    "build-wasm": "node scripts/build-wasm.mjs",
    "shorten-index-imports": "node scripts/shorten-index-imports.mjs",
    "prepare": "husky",
    "start": "lerna run start --scope @rivm-loculus-tools/phylogeny-viewer-app --scope @rivm-loculus-tools/sequence-editor-app --stream",
    "start-phylo": "pnpm --filter @rivm-loculus-tools/phylogeny-viewer-app start",
    "start-seq": "pnpm --filter @rivm-loculus-tools/sequence-editor-app start",
    "update-exports": "lerna run update-exports",
    "clean": "lerna clean && rm -fr node_modules",
    "validate": "lerna run validate --stream",
    "lint": "lerna run lint",
    "lint-fix": "lerna run lint-fix",
    "check-types": "lerna run check-types",
    "test": "lerna run test-run",
    "add-missing-translations": "lerna run add-missing-translations",
    "build": "lerna run build"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "concurrently": "10.0.6",
    "husky": "9.1.7",
    "lerna": "10.1.1",
    "typescript": "6.0.3"
  }
}